{
  "name": "claude-world",
  "version": "0.1.0",
  "description": "Claude World — AI-native OS as an isometric 2.5D city",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:icons": "node build/generate-icons.js",
    "build:mac": "electron-builder --mac",
    "build:dmg": "npm run build:icons && electron-builder --mac dmg",
    "build:dir": "electron-builder --mac dir",
    "rebuild": "npx @electron/rebuild",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "ai",
    "isometric",
    "orchestration"
  ],
  "author": "Stephane Boghossian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sboghossian/Claude-World.git"
  },
  "homepage": "https://github.com/sboghossian/Claude-World",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@electron/rebuild": "^4.0.3",
    "better-sqlite3": "^12.8.0",
    "electron": "^41.1.0",
    "openai": "^6.33.0",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.claudeworld.app",
    "productName": "Claude World",
    "copyright": "Copyright © 2026 Claude World",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Claude World",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 128,
      "contents": [
        {
          "x": 130,
          "y": 280,
          "type": "file"
        },
        {
          "x": 380,
          "y": 280,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "background": "build/dmg-background.png"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "package.json",
      "!src/**/*.test.*",
      "!**/.git/**"
    ],
    "extraResources": [],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "publish": null
  }
}
