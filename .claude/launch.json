{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "4321", "landing"],
      "port": 4321
    },
    {
      "name": "boot-test",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "require('http').createServer((q,r)=>{const fs=require('fs'),p=require('path'),u=q.url==='/'?'/src/renderer/test-boot.html':q.url,f=p.join(process.cwd(),u),t={'js':'text/javascript','mjs':'text/javascript','css':'text/css','html':'text/html','svg':'image/svg+xml'}[p.extname(f).slice(1)]||'application/octet-stream';fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);r.end('Not found: '+u)}else{r.writeHead(200,{'Content-Type':t,'Access-Control-Allow-Origin':'*'});r.end(d)}})}).listen(4322,()=>console.log('http://localhost:4322'))"
      ],
      "port": 4322
    }
  ]
}
